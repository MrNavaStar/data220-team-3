# Files the scripts rebuild every time -- they do not go into Git.
**/data/db/*.sqlite
**/data/interim/
**/data/processed/
**/output/
**/logs/*
!**/logs/.gitkeep
# RStudio and R session files
.Rproj.user/
**/.Rproj.user/
.Rhistory
.RData

# M2: full live API responses are regenerated; commit data/sample instead.
**/data/raw/api/

# M2: secrets (optional Socrata app token) never go into Git.
.Renviron
**/.Renviron
.env
**/.env
